FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/web
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund playwright@1.63.0 \
    && PLAYWRIGHT_BROWSERS_PATH=/opt/web/browsers npx playwright install --with-deps chromium \
    && chmod -R a+rX /opt/web
COPY web-runtime/run.cjs /opt/web/run.cjs
USER 65534:65534
